<!-- STAGE 0 (the launcher). This is the file XamlReader.Load is pointed at by Loader.cs when the
     program starts. Everything it does is declared here, not in code: every side effect below is
     an ObjectDataProvider invoking a built-in .NET/WPF method, and WPF constructs resource-
     dictionary entries in document order while parsing: so document order IS the program.

     The research question: can an EARLY object in a XAML document write a brand-new .xaml file to
     disk, and can a LATER object in that same document then load and run it: proving that a XAML
     stream can rewrite and re-extend its own behavior at runtime, purely through deserialization? -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:io="clr-namespace:System.IO;assembly=System.Runtime"
        xmlns:thr="clr-namespace:System.Threading;assembly=System.Threading.Thread"
        xmlns:mk="clr-namespace:System.Windows.Markup;assembly=PresentationFramework"
        Title="Stage 0 (launcher) - xaml-write-and-run" Width="480" Height="230"
        WindowStartupLocation="CenterScreen" Background="#172033">
<Window.Resources>

  <!-- The complete text of Stage 1's .xaml file (which itself carries Stage 2's text inside it,
       entity-escaped), carried verbatim via a CDATA section so none of its internal "<", ">", "&"
       characters are reinterpreted at THIS level: they only become real XML markup when Stage 1
       is parsed on its own, later, by its own nested XamlReader.Load call. -->
  <sys:String x:Key="stage1Payload" xml:space="preserve"><![CDATA[__STAGE1_CDATA__]]></sys:String>

  <ObjectDataProvider x:Key="log0a" ObjectType="{x:Type io:File}" MethodName="AppendAllText">
    <ObjectDataProvider.MethodParameters>
      <sys:String>data/run.log</sys:String>
      <sys:String xml:space="preserve">stage0 (launcher): started&#10;</sys:String>
    </ObjectDataProvider.MethodParameters>
  </ObjectDataProvider>

  <!-- Early object: writes a .xaml file that did not exist before this run. -->
  <ObjectDataProvider x:Key="writeStage1" ObjectType="{x:Type io:File}" MethodName="WriteAllText">
    <ObjectDataProvider.MethodParameters>
      <sys:String>data/stage1.generated.xaml</sys:String>
      <StaticResource ResourceKey="stage1Payload"/>
    </ObjectDataProvider.MethodParameters>
  </ObjectDataProvider>

  <ObjectDataProvider x:Key="log0b" ObjectType="{x:Type io:File}" MethodName="AppendAllText">
    <ObjectDataProvider.MethodParameters>
      <sys:String>data/run.log</sys:String>
      <sys:String xml:space="preserve">stage0: wrote data/stage1.generated.xaml&#10;</sys:String>
    </ObjectDataProvider.MethodParameters>
  </ObjectDataProvider>

  <ObjectDataProvider x:Key="sleep0" ObjectType="{x:Type thr:Thread}" MethodName="Sleep">
    <ObjectDataProvider.MethodParameters><sys:Int32>400</sys:Int32></ObjectDataProvider.MethodParameters>
  </ObjectDataProvider>

  <ObjectDataProvider x:Key="log0c" ObjectType="{x:Type io:File}" MethodName="AppendAllText">
    <ObjectDataProvider.MethodParameters>
      <sys:String>data/run.log</sys:String>
      <sys:String xml:space="preserve">stage0: slept 400ms&#10;</sys:String>
    </ObjectDataProvider.MethodParameters>
  </ObjectDataProvider>

  <!-- Later object, same document: opens the file the early object above just wrote. -->
  <io:FileStream x:Key="stage1Stream">
    <x:Arguments>
      <sys:String>data/stage1.generated.xaml</sys:String>
      <x:Static Member="io:FileMode.Open"/>
    </x:Arguments>
  </io:FileStream>

  <!-- ...and hands it to XamlReader.Load. This single call transitively runs Stage 1's ENTIRE
       resource dictionary (which itself writes, sleeps, loads, and shows Stage 2) before this
       ObjectDataProvider is considered done. One nested deserialization call, two more generations
       of self-written, self-run XAML underneath it. -->
  <ObjectDataProvider x:Key="loadStage1" ObjectType="{x:Type mk:XamlReader}" MethodName="Load">
    <ObjectDataProvider.MethodParameters><StaticResource ResourceKey="stage1Stream"/></ObjectDataProvider.MethodParameters>
  </ObjectDataProvider>

  <ObjectDataProvider x:Key="log0d" ObjectType="{x:Type io:File}" MethodName="AppendAllText">
    <ObjectDataProvider.MethodParameters>
      <sys:String>data/run.log</sys:String>
      <sys:String xml:space="preserve">stage0: loaded stage1 via XamlReader.Load (this transitively wrote+loaded+showed stage2 too)&#10;</sys:String>
    </ObjectDataProvider.MethodParameters>
  </ObjectDataProvider>

  <ObjectDataProvider x:Key="showStage1" ObjectInstance="{StaticResource loadStage1}" MethodName="Show"/>

  <ObjectDataProvider x:Key="log0e" ObjectType="{x:Type io:File}" MethodName="AppendAllText">
    <ObjectDataProvider.MethodParameters>
      <sys:String>data/run.log</sys:String>
      <sys:String xml:space="preserve">stage0: called Show() on the loaded stage1 window&#10;</sys:String>
    </ObjectDataProvider.MethodParameters>
  </ObjectDataProvider>

</Window.Resources>
<Grid x:Name="g0">
  <Grid.Triggers>
    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
      <BeginStoryboard><Storyboard>
        <DoubleAnimation Storyboard.TargetName="g0" Storyboard.TargetProperty="Opacity"
                          From="1" To="0.5" Duration="0:0:1" AutoReverse="True" RepeatBehavior="Forever"/>
      </Storyboard></BeginStoryboard>
    </EventTrigger>
  </Grid.Triggers>
  <StackPanel Margin="20">
    <TextBlock Foreground="#FFCE56" FontWeight="Bold" FontSize="16" TextWrapping="Wrap"
               Text="Stage 0 (launcher): I am the only file present when this program starts."/>
    <TextBlock Foreground="White" FontSize="13" Margin="0,10,0,0" TextWrapping="Wrap"
               Text="While being parsed, I wrote Stage 1 to disk, slept, loaded it with XamlReader.Load, and called Show() on it -- which in turn wrote, loaded, and showed Stage 2. See data/run.log for the full ordered trace."/>
  </StackPanel>
</Grid>
</Window>
