<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>XamlWriteAndRun</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- launcher.xaml is a program read and run by XamlReader.Load at run time: never compile it
         to BAML, and never give it an x:Class / code-behind. -->
    <Page Remove="**/*.xaml" />
    <None Include="launcher.xaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="launcher-remote.xaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
